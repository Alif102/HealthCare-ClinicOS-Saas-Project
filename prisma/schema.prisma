// ClinicOS — Phase 3 database schema
// Hybrid multi-tenancy: every clinic-scoped row carries tenantId.
// Auth tables match Better Auth's Prisma adapter (wired in Phase 4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  RECEPTIONIST
  DOCTOR
  PATIENT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  FOLLOW_UP
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  VOID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ─── Better Auth (Phase 4) ────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships TenantMembership[]

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?

  notifications Notification[]
  createdInvoices Invoice[] @relation("InvoiceCreatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hybrid tenancy: active clinic context for the session (optional until Phase 4)
  activeTenantId String?
  activeTenant   Tenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@unique([token])
  @@index([userId])
  @@index([activeTenantId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String
  logo        String?
  email       String?
  phone       String?
  address     String?
  timezone    String   @default("UTC")
  isActive    Boolean  @default(true)
  /// Clinic feature flags / preferences (e.g. { "aiAssistEnabled": true })
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     TenantMembership[]
  sessions        Session[]
  doctorProfiles  DoctorProfile[]
  patientProfiles PatientProfile[]
  appointments    Appointment[]
  prescriptions   Prescription[]
  allergies       Allergy[]
  conditions      MedicalCondition[]
  encounters      Encounter[]
  invoices        Invoice[]
  consultations   ConsultationSession[]
  notifications   Notification[]
  availabilities  DoctorAvailability[]

  @@unique([slug])
  @@map("tenant")
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("tenant_membership")
}

// ─── Doctor ───────────────────────────────────────────────────────────────────

model DoctorProfile {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String   @unique
  specialty      String
  licenseNumber  String?
  bio            String?
  consultationFee Decimal? @db.Decimal(10, 2)
  isAcceptingPatients Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilities DoctorAvailability[]
  appointments   Appointment[]        @relation("DoctorAppointments")
  prescriptions  Prescription[]       @relation("DoctorPrescriptions")
  encounters     Encounter[]          @relation("DoctorEncounters")

  @@index([tenantId])
  @@index([tenantId, specialty])
  @@map("doctor_profile")
}

model DoctorAvailability {
  id              String    @id @default(cuid())
  tenantId        String
  doctorProfileId String
  dayOfWeek       DayOfWeek
  startTime       String // "09:00" 24h local clinic time
  endTime         String // "17:00"
  slotMinutes     Int       @default(30)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, doctorProfileId])
  @@map("doctor_availability")
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model PatientProfile {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String    @unique
  dateOfBirth   DateTime?
  gender        Gender    @default(UNSPECIFIED)
  bloodType     String?
  phone         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments  Appointment[]   @relation("PatientAppointments")
  prescriptions Prescription[]  @relation("PatientPrescriptions")
  allergies     Allergy[]
  conditions    MedicalCondition[]
  encounters    Encounter[]
  invoices      Invoice[]

  @@index([tenantId])
  @@map("patient_profile")
}

// ─── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id               String            @id @default(cuid())
  tenantId         String
  doctorProfileId  String
  patientProfileId String
  startAt          DateTime
  endAt            DateTime
  status           AppointmentStatus @default(SCHEDULED)
  type             AppointmentType   @default(IN_PERSON)
  reason           String?
  notes            String?
  cancellationReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctorProfile  DoctorProfile  @relation("DoctorAppointments", fields: [doctorProfileId], references: [id], onDelete: Restrict)
  patientProfile PatientProfile @relation("PatientAppointments", fields: [patientProfileId], references: [id], onDelete: Restrict)
  encounter      Encounter?
  prescription   Prescription?
  invoice        Invoice?
  consultation   ConsultationSession?

  @@index([tenantId, startAt])
  @@index([tenantId, doctorProfileId, startAt])
  @@index([tenantId, patientProfileId, startAt])
  @@index([tenantId, status])
  @@map("appointment")
}

// ─── Clinical / Medical History ───────────────────────────────────────────────

model Allergy {
  id               String   @id @default(cuid())
  tenantId         String
  patientProfileId String
  allergen         String
  reaction         String?
  severity         String?
  notedAt          DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientProfileId])
  @@map("allergy")
}

model MedicalCondition {
  id               String    @id @default(cuid())
  tenantId         String
  patientProfileId String
  name             String
  status           String    @default("active") // active | resolved | chronic
  diagnosedAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientProfileId])
  @@map("medical_condition")
}

model Encounter {
  id               String   @id @default(cuid())
  tenantId         String
  appointmentId    String   @unique
  doctorProfileId  String
  patientProfileId String
  chiefComplaint   String?
  assessment       String?
  plan             String?
  vitalsJson       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorProfile  DoctorProfile  @relation("DoctorEncounters", fields: [doctorProfileId], references: [id], onDelete: Restrict)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientProfileId])
  @@index([tenantId, doctorProfileId])
  @@map("encounter")
}

// ─── Prescriptions ────────────────────────────────────────────────────────────

model Prescription {
  id               String             @id @default(cuid())
  tenantId         String
  appointmentId    String?            @unique
  doctorProfileId  String
  patientProfileId String
  status           PrescriptionStatus @default(DRAFT)
  notes            String?
  issuedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctorProfile  DoctorProfile       @relation("DoctorPrescriptions", fields: [doctorProfileId], references: [id], onDelete: Restrict)
  patientProfile PatientProfile      @relation("PatientPrescriptions", fields: [patientProfileId], references: [id], onDelete: Restrict)
  items          PrescriptionItem[]

  @@index([tenantId, patientProfileId])
  @@index([tenantId, doctorProfileId])
  @@map("prescription")
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  medicationName String
  dosage         String
  frequency      String
  duration       String?
  instructions   String?
  quantity       Int?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_item")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  patientProfileId String
  appointmentId    String?       @unique
  createdById      String?
  invoiceNumber    String
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @db.Decimal(10, 2)
  tax              Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  dueAt            DateTime?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments       Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, patientProfileId])
  @@map("invoice")
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CASH)
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment")
}

// ─── Video consultation (Phase 12) ────────────────────────────────────────────

model ConsultationSession {
  id            String    @id @default(cuid())
  tenantId      String
  appointmentId String    @unique
  roomName      String
  joinUrl       String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("consultation_session")
}

// ─── Notifications (Phase 13) ─────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  tenantId  String
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  isRead    Boolean             @default(false)
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@map("notification")
}
